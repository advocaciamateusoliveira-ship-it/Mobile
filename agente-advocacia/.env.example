# ===== Claude (obrigatório) =====
# Crie em https://console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=sk-ant-...

# ===== WhatsApp =====
# Qual canal usar: "evolution" (número comum/Business via QR Code) ou "meta" (API oficial)
WHATSAPP_PROVIDER=evolution

# --- Evolution API (https://doc.evolution-api.com) ---
EVOLUTION_URL=http://localhost:8080
EVOLUTION_API_KEY=troque-por-uma-chave-forte
EVOLUTION_INSTANCE=advocacia

# --- Meta WhatsApp Cloud API (oficial) ---
META_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=um-texto-qualquer-secreto

# ===== Google Agenda (opcional) =====
# Sem isso, o agente usa uma agenda local (data/agente.db).
GOOGLE_SERVICE_ACCOUNT_FILE=credenciais/google-service-account.json
GOOGLE_CALENDAR_ID=

# ===== Transcrição de áudio =====
# Modelo do faster-whisper: tiny | base | small | medium (maior = melhor e mais lento)
WHISPER_MODEL=small

# Segredo opcional para proteger o webhook (?token=...)
WEBHOOK_TOKEN=
